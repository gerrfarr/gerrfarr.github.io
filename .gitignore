# ============================================================================
# Hugo Site .gitignore
# ============================================================================

# ============================================================================
# Hugo Build Artifacts
# ============================================================================

# Generated site output
public/

# Hugo resources (processed assets)
resources/

# Hugo build lock
.hugo_build.lock

# Local agent / editor scratch
.claude/

# Hugo stats
hugo_stats.json

# Auto-generated JS config
**/assets/jsconfig.json

# ============================================================================
# Node.js & Package Managers
# ============================================================================

# Dependencies
node_modules/

# ============================================================================
# Environment & Configuration
# ============================================================================

# Environment variables
.env
.env.local
.env.*.local

# ============================================================================
# Generated Content
# ============================================================================

# Pagefind search index
pagefind/
static/pagefind/

# ============================================================================
# Operating System
# ============================================================================

# macOS
.DS_Store
.DS_Store?
._*

# Windows
Thumbs.db
Desktop.ini

# Linux
*~

# ============================================================================
# Logs & Temporary Files
# ============================================================================

*.log
npm-debug.log*

# Local package-manager cache
.pnpm-store/
/private-contact.tex

# LaTeX build artifacts. Sources and the two public PDFs stay versioned.
cv/*.aux
cv/*.bcf
cv/*.bbl
cv/*.blg
cv/*.fdb_latexmk
cv/*.fls
cv/*.out
cv/*.run.xml
cv/*.synctex.gz
cv/cv.pdf
cv/cv-application.pdf
cv/cv_G_Farren-application.pdf

resume/*.aux
resume/*.bcf
resume/*.bbl
resume/*.blg
resume/*.fdb_latexmk
resume/*.fls
resume/*.out
resume/*.run.xml
resume/*.synctex.gz
resume/industry_resume.pdf
resume/resume-application.pdf
resume/resume_G_Farren-application.pdf
